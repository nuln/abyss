# Abyss Configuration

[server]
addr = ":8080"
baseURL = ""

[data]
# Root directory for all application data
dir = "data"

[auth]
# Random 32-byte hex string. Auto-generated if empty.
jwtSecret = ""
# Optional dedicated key (hex, >=16 bytes) for the plugin crypto API.
# Falls back to jwtSecret when empty. Rotating it is safe: previously
# encrypted data stays readable during a transition period.
encryptionSecret = ""
accessTokenTTL = "24h"
refreshTokenTTL = "720h"
# Accept auth tokens from the ?token= query parameter. JWTs in URLs leak
# into proxy/access logs — enable only for debugging.
allowQueryToken = false

[database]
# Optional explicit path. Defaults to {data.dir}/abyss.db
path = ""
timeout = "3s"

# Demo Mode
demo = false
demoEmail = "demo@abyss.local"
demoPassword = "demo123456"
